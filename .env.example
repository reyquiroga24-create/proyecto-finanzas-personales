# ==========================================
# FIELD REPORT PRO - CONFIGURACIÓN
# ==========================================

# Entorno
NODE_ENV=production
PORT=3000

# Webhook - URL de Make.com o tu servidor
WEBHOOK_URL=https://hook.make.com/your-webhook-id

# Base de datos (opcional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=field_reports
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Seguridad
JWT_SECRET=your_super_secret_jwt_key_here

# Email (opcional, para notificaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# URLs
APP_URL=https://fieldreport.tudominio.com
API_URL=https://api.fieldreport.tudominio.com

# Logging
LOG_LEVEL=info

# Almacenamiento
STORAGE_TYPE=local
# STORAGE_TYPE=s3 (si usas AWS S3)
S3_BUCKET=your-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Caché
CACHE_ENABLED=true
CACHE_TTL=3600

# Rate limiting
RATE_LIMIT=100
RATE_LIMIT_WINDOW=900000

# CORS
CORS_ORIGIN=*
# CORS_ORIGIN=https://fieldreport.tudominio.com (producción)
